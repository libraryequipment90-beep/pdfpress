# Copy this file to .env and fill in your credentials.
# Google + Facebook developer accounts are required (free to create).

# --- Google sign-in ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID for a Web application).
# Add this Authorized redirect URI:
#   https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook sign-in ---
# Create an app at https://developers.facebook.com/apps
# (Facebook Login product > Settings). Under "Valid OAuth redirect URIs" add:
#   https://<your-domain>/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Optional ---
# Public URL of the frontend, used to build OAuth callback URLs.
# When not set, callbacks are built from the incoming request host.
# Set this to your deployed/preview domain, e.g.:
#   PUBLIC_URL=https://5173-xxxxxxxx.monkeycode-ai.live
PUBLIC_URL=

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
